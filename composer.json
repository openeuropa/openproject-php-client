{
    "name": "openeuropa/openproject-php-client",
    "description": "PHP client for the OpenProject API v3",
    "type": "library",
    "license": "EUPL-1.2",
    "autoload": {
        "psr-4": {
            "OpenEuropa\\OpenProjectClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEuropa\\OpenProjectClient\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "php-http/multipart-stream-builder": "^1.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "esi/phpunit-coverage-check": "^3.1",
        "guzzlehttp/guzzle": "^7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:integration": "phpunit --testsuite=integration",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text"
        ],
        "coverage:check": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=.phpunit.cache/clover.xml",
            "coverage-check .phpunit.cache/clover.xml 100 --show-files"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    }
}
